# ==============================================================================
# MFM PHOTOGRAPHY - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Local development:
# 1. Rename/copy this file to `.env`
# 2. Never commit `.env` to GitHub.
#
# Netlify:
# Add the required variables from this file in:
# Netlify Dashboard -> Site Configuration -> Environment Variables
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# These variables are used by the Vite/React frontend.
# VITE_* variables are publicly accessible in the browser.
#
# IMPORTANT:
# The Supabase Publishable Key is safe to expose in the frontend
# when Row Level Security (RLS) is correctly configured.
# NEVER put the Supabase Secret Key here.
# ------------------------------------------------------------------------------

# Supabase Project URL
VITE_SUPABASE_URL=https://kjaruqgzwzicvkccljls.supabase.co

# Supabase Publishable Key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7dDwyXcU8sSsDksx4igMHQ_6sKf-7ZV

# Google Apps Script Web App URL used for photo uploads
# Add the deployed Web App URL ending in /exec. No secrets belong in VITE_ variables.
VITE_GOOGLE_APPS_SCRIPT_URL=


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES
# ------------------------------------------------------------------------------
# These variables are ONLY for Netlify Functions / backend.
#
# NEVER add these variables with VITE_ prefix.
# NEVER expose them in React/Vite frontend code.
# NEVER upload them to GitHub.
# ------------------------------------------------------------------------------

# Supabase Project URL for backend
SUPABASE_URL=https://kjaruqgzwzicvkccljls.supabase.co

# Supabase Publishable Key for backend operations that use the public role
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7dDwyXcU8sSsDksx4igMHQ_6sKf-7ZV

# Supabase Secret Key
# DO NOT put the actual secret key in this template.
# Add the real value ONLY in Netlify Environment Variables.
SUPABASE_SECRET_KEY=


# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE - LEGACY NETLIFY UPLOAD FUNCTION
# ------------------------------------------------------------------------------
# Retained for the legacy Netlify Function; the React upload flow no longer uses it:
# /.netlify/functions/upload-to-drive
#
# These variables must remain server-side.
# ------------------------------------------------------------------------------

# Google Cloud Service Account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=photography-service-account@your-gcp-project.iam.gserviceaccount.com

# Google Service Account Private Key
# Add the real key only in Netlify Environment Variables.
GOOGLE_PRIVATE_KEY=""

# Google Drive folder ID where uploaded photos will be stored
GOOGLE_DRIVE_FOLDER_ID=


# ------------------------------------------------------------------------------
# 4. GOOGLE DRIVE - OAUTH2 (OPTIONAL)
# ------------------------------------------------------------------------------
# Use this only if you choose OAuth2 instead of a Service Account.
# Do not use both methods unless your backend is specifically designed for it.
# ------------------------------------------------------------------------------

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
