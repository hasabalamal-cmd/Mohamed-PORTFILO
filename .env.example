# ==============================================================================
# LENSO PHOTOGRAPHY - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` for local frontend development.
# 2. For Netlify deployment, set Frontend variables and Netlify Function variables
#    in Netlify Dashboard -> Site Configuration -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite - Publicly accessible in browser)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Public / Anon API Key (safe to expose in client)
# NEVER put your service_role key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Endpoint for the serverless upload function (defaults to /.netlify/functions/upload-to-drive)
VITE_UPLOAD_API_URL=/.netlify/functions/upload-to-drive

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (For Netlify Functions - NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# Configure these in Netlify Dashboard: Site Settings -> Environment Variables.

# --- OPTION A: Google Service Account (Recommended) ---
# Email of the Google Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=photography-service-account@your-gcp-project.iam.gserviceaccount.com

# Private Key with newlines escaped or quoted
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...\n-----END PRIVATE KEY-----\n"

# The target Google Drive folder ID where photos will be stored
# (Extract the ID from your Drive folder link: drive.google.com/drive/folders/YOUR_FOLDER_ID)
GOOGLE_DRIVE_FOLDER_ID=1abcXYZ_drive_folder_id_here

# --- OPTION B: Google OAuth2 Refresh Token (Alternative to Service Account) ---
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=1//your-refresh-token
